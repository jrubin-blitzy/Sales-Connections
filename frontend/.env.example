# =====================================================================
# frontend/.env.example - Sales-Connections frontend (Vite SPA) variables
# =====================================================================
#
# USAGE
#   1. Copy this file to frontend/.env: `cp frontend/.env.example frontend/.env`
#   2. Adjust values for your local development environment.
#   3. Never commit frontend/.env - it is in .gitignore.
#
# CRITICAL: Vite environment-variable rules
#   - Only variables prefixed VITE_ are exposed to client-side code via
#     `import.meta.env.VITE_*`.
#   - VITE_ values are BAKED INTO THE BUNDLE at build time. To change a
#     VITE_ value in production, the image MUST be rebuilt.
#   - Do NOT put secrets here. Anything in this file is potentially
#     visible to end users via DevTools or static-asset inspection.
#
# PRODUCTION
#   In production, VITE_* variables are passed as build args to
#   `frontend/Dockerfile` (e.g., docker build --build-arg
#   VITE_API_BASE_URL=https://api.sales-connections.example.com ...).
#
# CATEGORIES
#   - API connectivity
#   - Feature flags (none active in MVP, reserved for future)
#   - Observability and diagnostics
#   - Build-time tuning (Vite-only, not VITE_ prefixed)
# =====================================================================

# ---------------------------------------------------------------------
# API connectivity
# ---------------------------------------------------------------------

# Base URL for the Flask backend REST API.
#   - Local development (Vite dev server): leave as "/api" so requests
#     are dispatched through the Vite proxy in vite.config.ts to
#     http://localhost:5000 (where Flask is running).
#   - Containerized local stack (docker-compose): docker-compose.yml
#     overrides this to "http://localhost:5000" via build arg, because
#     the Vite dev server is not running; nginx serves the built bundle
#     and the SPA needs an absolute URL to reach the backend container.
#   - Production: set to the public ALB hostname, e.g.,
#     "https://api.sales-connections.example.com".
#
# Used by frontend/src/api/client.ts to construct absolute URLs.
VITE_API_BASE_URL=/api

# Optional: explicit auth-route base. Defaults to "/auth" (sibling of
# /api), mirroring backend/app/__init__.py blueprint registration where
# the OAuth surface is mounted under /auth (see AAP Sec 0.4.3).
# Used by frontend/src/auth/AuthProvider.tsx for redirects to
# /auth/google/start during the OAuth authorization-code flow.
VITE_AUTH_BASE_URL=/auth

# ---------------------------------------------------------------------
# Feature flags (placeholders - none active in MVP)
# ---------------------------------------------------------------------

# Enable verbose debug rendering of the TanStack Query devtools panel
# inside the running app. Allowed: "true" | "false". Default false.
# Affects frontend/src/main.tsx where the optional <ReactQueryDevtools>
# is conditionally mounted on top of the QueryClientProvider.
VITE_ENABLE_QUERY_DEVTOOLS=false

# Enable Mock Service Worker (MSW) for offline frontend development and
# tests. Allowed: "true" | "false". Default false. Used by
# frontend/tests/setup.ts to start the MSW worker before each test
# suite and by frontend/src/main.tsx for browser-side mocking when the
# Flask backend is unavailable.
VITE_ENABLE_MSW=false

# ---------------------------------------------------------------------
# Observability and diagnostics
# ---------------------------------------------------------------------

# Per-request correlation ID prefix. Defaults to "sc-fe-"
# (Sales-Connections frontend). The full correlation ID is
# "<prefix><uuid v4>" generated by frontend/src/lib/correlationId.ts
# and propagated as the X-Correlation-Id header on every API request
# (see AAP Sec 0.4.3). Coordinating prefixes between tiers makes
# log searches across structlog (backend) and the browser console
# trivially filterable.
VITE_CORRELATION_ID_PREFIX=sc-fe-

# Sentry DSN (optional - not in MVP scope, reserved for future). Empty
# by default; setting a value would enable client-side error reporting
# via the Sentry browser SDK. Note: Sentry's DSN is technically a public
# identifier, but we still ship MVP without it to avoid an additional
# vendor dependency.
# VITE_SENTRY_DSN=

# ---------------------------------------------------------------------
# Build-tooling variables (Node-only; NOT exposed to client code)
# ---------------------------------------------------------------------

# Node environment selector. Vite reads this at build time to drop
# dev-only code from the production bundle (e.g., React DevTools hooks,
# warning messages). Set automatically by Vite when invoking
# `vite build` (production) or `vite` / `vite dev` (development); this
# value is the explicit fallback for tooling that does not set it.
NODE_ENV=development

# Optional: override the Vite dev-server port. Default 5173. Read by
# vite.config.ts when binding the dev server. Uncomment and adjust if
# port 5173 is already taken on your machine.
# VITE_DEV_SERVER_PORT=5173

# Optional: override the dev-server proxy target that vite.config.ts
# uses to forward /api, /auth, /healthz, /readyz, and /metrics to the
# local Flask backend. Defaults to "http://localhost:5000". Adjust if
# Flask is running on a non-default host or port (e.g., a remote dev
# container or a Docker-bridge IP). Honoured by vite.config.ts via
# `process.env.VITE_DEV_API_PROXY_TARGET`.
# VITE_DEV_API_PROXY_TARGET=http://localhost:5000

# =====================================================================
# END OF frontend/.env.example
# =====================================================================
# When adding a new variable:
#   1. Document its purpose, allowed values, and default in this file.
#   2. If the variable is exposed to client code, prefix it with VITE_.
#   3. Update frontend/src/api/client.ts (or relevant file) to read it.
#   4. Add a corresponding ARG in frontend/Dockerfile if it must be
#      baked into production bundles at build time.
# =====================================================================
