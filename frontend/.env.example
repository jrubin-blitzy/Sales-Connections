# =============================================================================
# Sales-Connections Frontend - Local Development Environment Variables
# =============================================================================
# Copy to `.env.local` for your local environment. Only variables prefixed with
# `VITE_` are exposed to the client bundle.
# =============================================================================

# Base URL the frontend uses when calling the backend.
# Leave blank when using the Vite dev-server proxy (default for `npm run dev`).
# Set to an absolute URL when serving the SPA from a different origin
# (e.g. https://api.staging.example.com).
VITE_API_BASE_URL=

# Vite dev-server proxy target. Honours VITE_DEV_API_PROXY_TARGET in
# vite.config.ts.
VITE_DEV_API_PROXY_TARGET=http://localhost:5000

# Optional feature flags surfaced via env at build time.
VITE_FEATURE_ADMIN_PANEL=true
VITE_FEATURE_AI_NOTES=true
