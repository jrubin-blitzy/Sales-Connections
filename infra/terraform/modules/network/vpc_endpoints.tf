###############################################################################
# infra/terraform/modules/network/vpc_endpoints.tf
#
# Optional VPC endpoints for AWS service access without traversing NAT
# gateways or the public Internet. Activated by var.create_vpc_endpoints
# (default false for MVP simplicity; set true in production for cost
# optimization on ECS tasks pulling images and reading secrets).
#
# Endpoint inventory:
#   - S3 (gateway)            -> ECR layer downloads (S3-backed)
#   - ECR API (interface)     -> ECR API calls (DescribeImages, etc.)
#   - ECR DKR (interface)     -> ECR Docker registry calls (image pull)
#   - Secrets Manager (intf)  -> Secret retrieval by ECS task role at boot
#   - CloudWatch Logs (intf)  -> Log ingestion from ECS task awslogs driver
#   - KMS (intf)              -> Decrypt operations during secret resolution
#
# Cost trade-off: Interface endpoints carry an hourly charge per AZ per
# endpoint (~$0.01/hr), versus NAT data transfer at ~$0.045/GB. Endpoints
# break even at moderate traffic; production should enable them.
#
# All resources are gated by `count = var.create_vpc_endpoints ? 1 : 0`
# so this file is safely skipped when endpoints are disabled.
#
# Inputs consumed (from variables.tf):
#   - var.create_vpc_endpoints : Master gate for every resource in this file
#   - var.name_prefix          : Resource Name-tag prefix
#   - var.vpc_cidr             : SG ingress CIDR for HTTPS:443 from VPC
#
# Locals consumed (from locals.tf):
#   - local.module_tags : Base tag set merged into every resource
#
# Foundational resources consumed (from main.tf):
#   - aws_vpc.main           : vpc_id for the SG and every endpoint
#   - aws_subnet.private[*]  : subnet_ids list for the five interface endpoints
#   - aws_route_table.private[*] : route_table_ids list for the S3 gateway endpoint
###############################################################################

###############################################################################
# Region data source (for VPC endpoint service names)
#
# Interface VPC endpoint service names are region-qualified
# (e.g., 'com.amazonaws.us-east-1.ecr.api'). Declared inline here because
# this file is the only consumer of the region in the module; a separate
# data.tf is unnecessary per the folder spec.
###############################################################################

data "aws_region" "current" {}

###############################################################################
# Security group for interface VPC endpoints
#
# Interface endpoints provision ENIs in private subnets; this SG controls
# what can talk to those ENIs. We allow HTTPS:443 from the entire VPC CIDR
# so any private resource (ECS task, RDS Lambda, future workers) can reach
# the endpoints. SG-level egress is left default-permissive; AWS service
# routing constrains where the endpoint can actually send traffic.
###############################################################################

resource "aws_security_group" "vpc_endpoints" {
  count = var.create_vpc_endpoints ? 1 : 0

  name_prefix = "${var.name_prefix}-vpce-"
  description = "HTTPS ingress from VPC CIDR for interface VPC endpoints"
  vpc_id      = aws_vpc.main.id

  ingress {
    description = "HTTPS from VPC for interface endpoint ENIs"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = [var.vpc_cidr]
  }

  egress {
    description = "Default permissive egress; AWS service routing constrains targets"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = merge(local.module_tags, {
    Name = "${var.name_prefix}-vpce-sg"
  })

  # name_prefix requires create_before_destroy to avoid name collisions on
  # SG replacement (since the suffix is generated by AWS).
  lifecycle {
    create_before_destroy = true
  }
}

###############################################################################
# S3 gateway VPC endpoint
#
# Gateway endpoints are free (no hourly charge) and route via route table
# entries rather than ENIs. ECR image layers are S3-backed, so this endpoint
# materially reduces NAT data transfer for image pulls.
#
# route_table_ids spans all private route tables (one when single_nat_gateway
# is true; one per AZ otherwise). The splat handles both cases without
# branching here.
###############################################################################

resource "aws_vpc_endpoint" "s3" {
  count = var.create_vpc_endpoints ? 1 : 0

  vpc_id            = aws_vpc.main.id
  service_name      = "com.amazonaws.${data.aws_region.current.name}.s3"
  vpc_endpoint_type = "Gateway"
  route_table_ids   = aws_route_table.private[*].id

  tags = merge(local.module_tags, {
    Name = "${var.name_prefix}-vpce-s3"
  })
}

###############################################################################
# ECR API interface VPC endpoint
#
# Routes ecr.<region>.amazonaws.com API calls (DescribeImages,
# GetAuthorizationToken) to private ENIs. Required alongside the ecr.dkr
# endpoint for fully-private ECS image pulls.
#
# private_dns_enabled = true causes the VPC's Route 53 resolver to map
# the standard ECR DNS names to the endpoint ENIs transparently, so no
# application-side configuration change is required.
###############################################################################

resource "aws_vpc_endpoint" "ecr_api" {
  count = var.create_vpc_endpoints ? 1 : 0

  vpc_id              = aws_vpc.main.id
  service_name        = "com.amazonaws.${data.aws_region.current.name}.ecr.api"
  vpc_endpoint_type   = "Interface"
  subnet_ids          = aws_subnet.private[*].id
  security_group_ids  = [aws_security_group.vpc_endpoints[0].id]
  private_dns_enabled = true

  tags = merge(local.module_tags, {
    Name = "${var.name_prefix}-vpce-ecr-api"
  })
}

###############################################################################
# ECR Docker registry interface VPC endpoint
#
# Routes ecr.dkr.<region>.amazonaws.com Docker registry traffic to private
# ENIs. Combined with the s3 gateway endpoint, this completes the private
# ECS image-pull path: ECR API -> ECR DKR -> S3 (layer storage).
###############################################################################

resource "aws_vpc_endpoint" "ecr_dkr" {
  count = var.create_vpc_endpoints ? 1 : 0

  vpc_id              = aws_vpc.main.id
  service_name        = "com.amazonaws.${data.aws_region.current.name}.ecr.dkr"
  vpc_endpoint_type   = "Interface"
  subnet_ids          = aws_subnet.private[*].id
  security_group_ids  = [aws_security_group.vpc_endpoints[0].id]
  private_dns_enabled = true

  tags = merge(local.module_tags, {
    Name = "${var.name_prefix}-vpce-ecr-dkr"
  })
}

###############################################################################
# Secrets Manager interface VPC endpoint
#
# Routes secretsmanager.<region>.amazonaws.com API calls to private ENIs.
# ECS task role reads the four application secrets at boot:
#   ANTHROPIC_API_KEY, GOOGLE_OAUTH_CLIENT_SECRET, JWT_SIGNING_KEY, DB_PASSWORD
# (per AAP Sec 0.4.6). Each read traverses this endpoint when enabled.
###############################################################################

resource "aws_vpc_endpoint" "secretsmanager" {
  count = var.create_vpc_endpoints ? 1 : 0

  vpc_id              = aws_vpc.main.id
  service_name        = "com.amazonaws.${data.aws_region.current.name}.secretsmanager"
  vpc_endpoint_type   = "Interface"
  subnet_ids          = aws_subnet.private[*].id
  security_group_ids  = [aws_security_group.vpc_endpoints[0].id]
  private_dns_enabled = true

  tags = merge(local.module_tags, {
    Name = "${var.name_prefix}-vpce-secretsmanager"
  })
}

###############################################################################
# CloudWatch Logs interface VPC endpoint
#
# Routes logs.<region>.amazonaws.com API calls to private ENIs. The ECS
# awslogs driver streams structured JSON logs (per AAP Sec 0.7.5
# Observability rule) continuously; this endpoint keeps the bulk of that
# traffic off NAT.
###############################################################################

resource "aws_vpc_endpoint" "logs" {
  count = var.create_vpc_endpoints ? 1 : 0

  vpc_id              = aws_vpc.main.id
  service_name        = "com.amazonaws.${data.aws_region.current.name}.logs"
  vpc_endpoint_type   = "Interface"
  subnet_ids          = aws_subnet.private[*].id
  security_group_ids  = [aws_security_group.vpc_endpoints[0].id]
  private_dns_enabled = true

  tags = merge(local.module_tags, {
    Name = "${var.name_prefix}-vpce-logs"
  })
}

###############################################################################
# KMS interface VPC endpoint
#
# Routes kms.<region>.amazonaws.com API calls to private ENIs. KMS Decrypt
# is invoked transparently by Secrets Manager during secret resolution
# when secrets are encrypted with a customer-managed CMK; this endpoint
# completes the private secret-resolution path.
###############################################################################

resource "aws_vpc_endpoint" "kms" {
  count = var.create_vpc_endpoints ? 1 : 0

  vpc_id              = aws_vpc.main.id
  service_name        = "com.amazonaws.${data.aws_region.current.name}.kms"
  vpc_endpoint_type   = "Interface"
  subnet_ids          = aws_subnet.private[*].id
  security_group_ids  = [aws_security_group.vpc_endpoints[0].id]
  private_dns_enabled = true

  tags = merge(local.module_tags, {
    Name = "${var.name_prefix}-vpce-kms"
  })
}
