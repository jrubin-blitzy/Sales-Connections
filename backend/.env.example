# =============================================================================
# Sales-Connections Backend - Local Development Environment Variables
# =============================================================================
# Copy to `.env` and adjust values for your local environment.
# In production these values are sourced from AWS Secrets Manager and the ECS
# task definition - see docs/operations.md.
#
# NEVER commit a real `.env` file to version control. The `.gitignore` at the
# repository root excludes `.env` and `.env.*.local`.
# =============================================================================

# ---------- Flask runtime ----------
FLASK_ENV=development
FLASK_APP=wsgi:app
FLASK_DEBUG=1
LOG_LEVEL=DEBUG
WEB_CONCURRENCY=2

# ---------- Database ----------
# Local docker-compose default; override for RDS / external DB.
DATABASE_URL=postgresql+psycopg://sales_connections:sales_connections@localhost:5432/sales_connections

# ---------- Anthropic Claude API (F-002) ----------
# In production this is loaded from AWS Secrets Manager. For local dev, paste
# a personal API key here. NEVER commit. Get a key from https://console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-replace-me
ANTHROPIC_MODEL=claude-sonnet-4-5
AI_TIMEOUT_SECONDS=5

# ---------- Google OAuth (F-012) ----------
# Configure an OAuth 2.0 client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI for local dev: http://localhost:5000/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# ---------- JWT / Session ----------
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(64))'
JWT_SIGNING_KEY=change-me-please-and-rotate-on-incident
JWT_EXPIRY_HOURS=8
SESSION_COOKIE_NAME=session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# ---------- AWS (Secrets Manager / S3) ----------
# Leave AWS_PROFILE blank to use the default chain. In ECS the task role
# auto-injects credentials; explicit values below are for local dev only.
AWS_REGION=us-east-1
AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
SECRETS_PREFIX=sales-connections/dev/

# ---------- Observability ----------
OTLP_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=sales-connections-api
OTEL_TRACES_EXPORTER=otlp
PROMETHEUS_METRICS_PATH=/metrics

# ---------- CORS / Frontend ----------
FRONTEND_ORIGIN=http://localhost:5173
