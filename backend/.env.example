# =====================================================================
# backend/.env.example - Sales-Connections backend environment variables
# =====================================================================
#
# USAGE
#   1. Copy this file to backend/.env: `cp backend/.env.example backend/.env`
#   2. Replace placeholder values (PLACEHOLDER_*) with real values for your
#      local development environment.
#   3. Never commit backend/.env - it is in .gitignore.
#
# PRODUCTION
#   In production, these values are sourced from AWS Secrets Manager via
#   boto3 at process startup (see backend/app/config.py). Do NOT use this
#   .env file in production.
#
# CATEGORIES
#   - Flask runtime
#   - Database connection
#   - Authentication (JWT, Google OAuth)
#   - AI integration (Anthropic Claude)
#   - Observability (logs, metrics, traces)
#   - AWS configuration (only when developing against real AWS resources)
#   - CORS / Frontend origin
#   - Single-Org MVP defaults
# =====================================================================

# ---------------------------------------------------------------------
# Flask Runtime
# ---------------------------------------------------------------------

# Flask environment selector. Drives configuration class selection in
# backend/app/config.py. Allowed values: development, testing, production.
FLASK_ENV=development

# Application secret key used by Flask for session cookies and CSRF.
# In development this is a static placeholder; in production it is loaded
# from Secrets Manager.
FLASK_SECRET_KEY=PLACEHOLDER_FLASK_SECRET_DO_NOT_USE_IN_PROD

# Logging level for structlog and the standard library logger.
# Allowed values: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=DEBUG

# Gunicorn worker concurrency. Default 4; set to 1 for single-worker debugging.
WEB_CONCURRENCY=2

# Whether to run Alembic migrations on container startup.
# Set to "true" for the docker-compose dev stack; "false" for ECS API tasks
# (a dedicated ECS task runs migrations in production).
RUN_MIGRATIONS=true

# ---------------------------------------------------------------------
# Database (PostgreSQL 17.7)
# ---------------------------------------------------------------------

# SQLAlchemy DSN for psycopg 3.x driver. Format:
#   postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
#
# For docker-compose, host is the service name "postgres".
DATABASE_URL=postgresql+psycopg://sales_connections:sales_connections_dev@postgres:5432/sales_connections

# Optional: separate URL for the elevated migrations role with
# UPDATE/DELETE privileges on audit_events. If unset, DATABASE_URL is reused
# (acceptable for local dev; production sets a separate role).
# MIGRATIONS_DATABASE_URL=

# SQLAlchemy connection pool size. Default matches Gunicorn worker count.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# SQLAlchemy SQL echo. When "true", every executed SQL statement is logged
# to stdout/structlog at INFO level (useful for diagnosing N+1 queries,
# missing indexes, and ORM session-flush surprises during local development).
# Default "false" - production MUST leave this disabled because the echo
# stream contains row-level data that may include user-supplied PII.
# Allowed values: true, false (case-insensitive).
DB_ECHO=false

# ---------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------

# HMAC secret used to sign session JWT cookies (PyJWT, HS256).
#
# REQUIREMENT: At least 32 BYTES of UTF-8 to retain the 256-bit HS256
# security level (NIST SP 800-117, RFC 7518 sec. 3.2). ProductionConfig
# refuses to start when this value is shorter than 32 bytes OR still
# carries a PLACEHOLDER_/REPLACE_WITH_ prefix (see
# backend/app/config.py::ProductionConfig._validate_required_secrets).
# Generate a real value with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# In production, this is loaded from AWS Secrets Manager and rotated via
# versioned KMS keys.
JWT_SIGNING_KEY=PLACEHOLDER_JWT_SIGNING_KEY_REPLACE_WITH_32_RANDOM_BYTES

# Session cookie lifetime in seconds. Default 8 hours = 28800 seconds.
JWT_TTL_SECONDS=28800

# Google OAuth 2.0 client credentials. Obtain from
# https://console.cloud.google.com/apis/credentials. Configure the OAuth
# consent screen and redirect URI:
#   http://localhost:5000/auth/google/callback (dev)
#   https://app.sales-connections.example.com/auth/google/callback (prod)
GOOGLE_OAUTH_CLIENT_ID=PLACEHOLDER_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=PLACEHOLDER_GOOGLE_OAUTH_CLIENT_SECRET

# Redirect URI registered with Google. Must match exactly.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Bcrypt cost factor for email/password hashes (per AAP 0.5.2).
# Default 12 (~250ms hash time on modern hardware). Range 4-31.
BCRYPT_COST=12

# Cookie attributes. SECURE=true requires HTTPS; set to false for local dev.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_HTTPONLY=true

# ---------------------------------------------------------------------
# AI Integration (Anthropic Claude via Langchain)
# ---------------------------------------------------------------------

# Anthropic API key. Obtain from https://console.anthropic.com/.
# In production, loaded from Secrets Manager. AI failures are non-blocking
# (form submission proceeds regardless), so an empty key is acceptable for
# developers not actively testing F-002.
ANTHROPIC_API_KEY=

# Claude model identifier passed to Langchain ChatAnthropic.
# Pinned per AAP 0.4.4. Update only with a corresponding decision-log entry.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Maximum tokens for the AI response. Per AAP 0.4.4, the prompt is bounded
# to keep latency under the 5s P95 budget.
ANTHROPIC_MAX_TOKENS=512

# AI request timeout in seconds (P95 budget per AAP 0.7.3).
AI_REQUEST_TIMEOUT_SECONDS=5

# ---------------------------------------------------------------------
# Observability (per AAP 0.7.5 "Observability rule")
# ---------------------------------------------------------------------

# OTLP exporter endpoint for OpenTelemetry traces. Empty string disables
# exporter (acceptable for local dev when no collector is running).
# Examples:
#   http://localhost:4318/v1/traces (Jaeger collector via OTLP HTTP)
#   https://api.honeycomb.io (Honeycomb)
OTLP_EXPORTER_ENDPOINT=

# OTLP exporter headers for collectors that require authentication
# (e.g., Honeycomb, Grafana Cloud, vendor-managed OTLP gateways).
# Format: comma-separated `key=value` pairs encoded as a single string.
# Example: OTLP_EXPORTER_HEADERS=x-honeycomb-team=PLACEHOLDER_HONEYCOMB_TOKEN
# Multi-header example:
#   OTLP_EXPORTER_HEADERS=Authorization=Bearer PLACEHOLDER_TOKEN,X-Tenant-Id=acme
# Default empty (no headers added). Optional whenever
# OTLP_EXPORTER_ENDPOINT targets a collector that does not require auth
# (e.g., a local Jaeger/OTel collector inside the docker-compose network).
OTLP_EXPORTER_HEADERS=

# OpenTelemetry service name reported in traces. Default sales-connections-api.
OTEL_SERVICE_NAME=sales-connections-api

# Prometheus metrics endpoint authentication. If empty, /metrics is public
# (acceptable inside a private VPC). Set to a static bearer token for shared
# environments.
METRICS_BEARER_TOKEN=

# structlog log format. Allowed values: json (production), console (dev).
LOG_FORMAT=json

# ---------------------------------------------------------------------
# AWS (only when developing against real AWS resources)
# ---------------------------------------------------------------------

# AWS region. Production is typically us-east-1 or us-west-2.
AWS_REGION=us-east-1

# Secret IDs / ARNs in AWS Secrets Manager. In dev these can be left blank;
# the application falls back to reading the variables directly from .env
# instead of via boto3 calls (see backend/app/config.py).
SECRETS_MANAGER_ANTHROPIC_KEY_ID=
SECRETS_MANAGER_GOOGLE_OAUTH_SECRET_ID=
SECRETS_MANAGER_JWT_SIGNING_KEY_ID=
SECRETS_MANAGER_DB_PASSWORD_ID=

# Whether to source secrets from AWS Secrets Manager at startup.
# Set to "true" only when running against real AWS infra (e.g., dev/staging).
USE_SECRETS_MANAGER=false

# Optional: explicit AWS credentials (only when not using IAM role / OIDC).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------
# CORS / Frontend Origin
# ---------------------------------------------------------------------

# Comma-separated list of allowed origins for cookie-bearing requests.
# Production: https://app.sales-connections.example.com
# Local dev: http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Whether to allow credentials (cookies) in CORS requests.
CORS_ALLOW_CREDENTIALS=true

# ---------------------------------------------------------------------
# Single-Org MVP (per AAP 0.7.2)
# ---------------------------------------------------------------------

# UUID of the sole organization served at MVP. The data model is multi-tenant
# (org_id columns everywhere) but runtime serves exactly one org per AAP.
# Set during initial migration / seed; pin here so the JWT minting service
# can attach the correct org_id to new sessions.
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001

# Default role for newly upserted OAuth users. Allowed: Admin, Contributor, Viewer.
# Production typically uses Contributor (Admin promoted manually).
DEFAULT_NEW_USER_ROLE=Contributor

# =====================================================================
# END OF backend/.env.example
# =====================================================================
# When adding a new environment variable:
#   1. Document its purpose, allowed values, and default in this file.
#   2. Add a corresponding entry to backend/app/config.py to load it.
#   3. Reference the variable in backend/tests/conftest.py if tests need it.
#   4. Update docs/operations.md secret-rotation runbook if it carries a secret.
# =====================================================================
